# ============================================================
# Banned Pharma RAG API — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================================

# --- AWS Credentials ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# --- Bedrock Knowledge Base ---
BEDROCK_KB_ID=KB-XXXXXXXXXXXXX
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# --- Kendra (used internally by Bedrock KB) ---
KENDRA_INDEX_ARN=arn:aws:kendra:us-east-1:ACCOUNT_ID:index/INDEX_ID

# --- Optional: Data Source ID (auto-detected if only one exists) ---
# BEDROCK_DATA_SOURCE_ID=

# --- Soft-Delete Feature ---
# When true, delete_document sets _is_active=false before hard-deleting.
# Requires '_is_active' custom attribute registered in Kendra index.
# Set to false to disable if Kendra attribute hasn't been configured.
ENABLE_SOFT_DELETE=true

# --- Server ---
PORT=3101
LOG_LEVEL=INFO

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=*
